{
  "name": "coelhonexus-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write",
    "lint:biome": "biome check",
    "lint:eslint": "eslint",
    "lint": "npm run lint:biome && npm run lint:eslint",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "test:e2e": "playwright test",
    "api:generate": "openapi-ts",
    "api:check": "node scripts/check-api-drift.mjs",
    "tokens": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "budgets": "node scripts/check-budgets.mjs",
    "copy:check": "node scripts/check-public-copy.mjs",
    "verify": "npm run lint && npm run typecheck && npm run knip && npm run test && npm run test:boundaries && npm run tokens:check && npm run api:check && npm run copy:check",
    "verify:full": "npm run verify && npm run build && npm run budgets && npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "eventsource-parser": "4.1.2",
    "lucide-react": "1.50.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "culori": "4.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-boundaries": "7.3.0",
    "jsdom": "30.1.1",
    "knip": "6.43.0",
    "msw": "3.0.3",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
