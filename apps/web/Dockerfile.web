FROM node:24-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

FROM node:24-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# Routing is compiled into the build (see src/shared/config/rewrites.ts), so these are build args:
#   SERVER_URL      the Nexus API
#   EXPOSE_API_DOCS proxy /docs and /openapi.json (off: the schema is not public)
ARG SERVER_URL=http://coelhonexus-server:8000
ARG EXPOSE_API_DOCS=false
ENV SERVER_URL=$SERVER_URL \
    EXPOSE_API_DOCS=$EXPOSE_API_DOCS
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:24-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
