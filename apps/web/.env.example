# Routing is compiled into the Next build (rewrites), so these are read at
# `next dev` / `next build` time — in Kubernetes they are Docker build args
# (Dockerfile.web defaults, overridden in skaffold.yaml). See src/shared/config/env.ts.

# The Nexus API. Local dev: the Skaffold port-forward for the server.
SERVER_URL=http://localhost:23030

# The legacy FastHTML UI. When set, every path the Next app does not serve yet
# falls back to it (strangler migration). Local dev: its port-forward.
# FASTHTML_URL=http://localhost:23033

# Proxy the API's /docs and /openapi.json through this app (default: off).
# EXPOSE_API_DOCS=true
