{
  "title": "COELHO Nexus - YCS Ingestion",
  "uid": "coelhonexus-ycs-ingestion",
  "tags": [
    "coelhonexus",
    "ycs",
    "ingestion",
    "otel",
    "mimir"
  ],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/coelhonexus-overview",
      "targetBlank": false
    },
    {
      "title": "DD Pipeline",
      "type": "link",
      "url": "/d/coelhonexus-dd-pipeline",
      "targetBlank": false
    },
    {
      "title": "YCS Ask",
      "type": "link",
      "url": "/d/coelhonexus-ycs-retrieval",
      "targetBlank": false
    },
    {
      "title": "RR Scan",
      "type": "link",
      "url": "/d/coelhonexus-rr-digests",
      "targetBlank": false
    },
    {
      "title": "LLM Call Health",
      "type": "link",
      "url": "/d/coelhonexus-llm-call-health",
      "targetBlank": false
    },
    {
      "title": "Service Topology",
      "type": "link",
      "url": "/d/coelhonexus-service-topology",
      "targetBlank": false
    },
    {
      "title": "Investigations",
      "type": "link",
      "url": "/d/coelhonexus-investigations",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(ycs_ingest_run_total, kind)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ingest run outcomes observed",
      "description": "kind ∈ {extract_videos, extract_channel, extract_playlist, embedding_migration}.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (kind, outcome) (max_over_time(ycs_ingest_run_total{kind=~\"$kind\"}[7d]))",
          "legendFormat": "{{kind}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ingest duration (p50 / p95, all kinds)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ycs_ingest_run_duration_seconds_bucket{kind=~\"$kind\"}[30m])))",
          "exemplar": true,
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ycs_ingest_run_duration_seconds_bucket{kind=~\"$kind\"}[30m])))",
          "exemplar": true,
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error share",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(max_over_time(ycs_ingest_run_total{kind=~\"$kind\",outcome=\"error\"}[7d])) / clamp_min(sum(max_over_time(ycs_ingest_run_total{kind=~\"$kind\"}[7d])), 1)",
          "legendFormat": "error share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingest duration p95 by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(ycs_ingest_run_duration_seconds_bucket{kind=~\"$kind\"}[30m])))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Ingest run summary by kind / outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (kind, outcome) (max_over_time(ycs_ingest_run_total{kind=~\"$kind\"}[7d]))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent YCS ingestion error logs",
      "description": "Celery log lines from the extract/qdrant_task/neo4j_task/embedding_migration tasks.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=~\"coelhonexus.*\",service_name=\"coelhonexus-celery\"} |~ \"(?i)(extract_videos|extract_channel|extract_playlist|ingest_to_qdrant|ingest_to_neo4j|embedding_migration|error|exception|traceback|failed)\" | regexp \"(?P<trace_id>(?i)trace_id=[0-9a-f]{32})\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "YCS ingestion log rate by level",
      "description": "5-minute rolling rate of YCS ingestion log events by severity.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (detected_level) (count_over_time({namespace=~\"coelhonexus.*\",service_name=\"coelhonexus-celery\"} |~ \"(?i)(extract_videos|extract_channel|extract_playlist|ingest_to_qdrant|ingest_to_neo4j|embedding_migration)\" [5m]))",
          "legendFormat": "{{detected_level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#E02F44",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#FF9830",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3274D9",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "traces",
      "title": "YCS ingestion workflow-root traces (Tempo)",
      "description": "ycs.extract.{videos,channel,playlist} / ycs.ingest.{qdrant,neo4j}.run / ycs.embedding_migration.finalize — one row per Celery ingestion task run. Click a row to open the full trace waterfall.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name=\"coelhonexus-celery\" && name =~ \"ycs.(extract|ingest).+|ycs.embedding_migration.finalize\" }",
          "limit": 20,
          "refId": "A",
          "tableType": "traces"
        }
      ]
    }
  ]
}
